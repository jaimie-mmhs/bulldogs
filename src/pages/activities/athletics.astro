---
import Base from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/PageHero.astro";
import {site} from "~/site.config";

const title = "Athletics";
const subtitle = "Bulldogs";
const description = "";

// Breadcrumbs: last item is current page (no href)
const breadcrumb = [
  {label: "Home", href: "/"},
  {label: "Activities"},
  {label: title},
];
---

<Base title={`${title} | ${site.name}`} description={description}>
  <PageHero title={title} subtitle={subtitle} breadcrumb={breadcrumb} />

  <article
    class="prose prose-slate md:prose-lg mx-auto max-w-3xl px-4 py-10
           prose-a:text-bulldog-orange prose-a:no-underline hover:prose-a:underline
           prose-img:rounded-xl prose-headings:font-semibold"
  >
    <h2 class="text-2xl font-semibold mb-4">MMHS Athletics</h2>
  </article>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mx-auto max-w-4xl">
    <article class="rounded-2xl border bg-white p-5 shadow-sm hover:shadow-md">
      <h3 class="text-lg font-semibold">MMHS Bulldogs Youtube Channel</h3>
      <p class="mt-2 text-sm text-slate-600">
        <a class="link" href="http://www.youtube.com/@MMHSBulldogs">
          @MMHSBulldogs</a
        >
      </p>
    </article>
    <article class="rounded-2xl border bg-white p-5 shadow-sm hover:shadow-md">
      <h3 class="text-lg font-semibold">Athletics Schedules</h3>
      <p>
        <a class="link" href="https://www.bulldogathletics1.com">from Playon</a>
      </p>
    </article>
  </div>

  <article
    class="prose prose-slate md:prose-lg mx-auto max-w-3xl px-4 py-6
           prose-a:text-bulldog-orange prose-a:no-underline hover:prose-a:underline
           prose-img:rounded-xl prose-headings:font-semibold"
  >
    <h3 class="text-2xl font-semibold mb-2">Arbiter</h3>
  </article>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mx-auto max-w-4xl">
    <article class="rounded-2xl border bg-white p-5 shadow-sm hover:shadow-md">
      <p>
        <a class="link" href="https://arbiterlive.com">Arbiter Live App</a>
      </p>
    </article>
    <article class="rounded-2xl border bg-white p-5 shadow-sm hover:shadow-md">
      <p>
        <a class="link" href="https://arbiterlive.com/Teams?entityId=13482"
          >Machias Teams</a
        >
      </p>
    </article>
    <article class="rounded-2xl border bg-white p-5 shadow-sm hover:shadow-md">
      <p>
        <a class="link" href="https://arbiterlive.com/School/Calendar/13482"
          >Athletics Calendar</a
        >
      </p>
    </article>
  </div>
    <article
      class="prose prose-slate md:prose-lg mx-auto max-w-3xl px-4 py-10
           prose-a:text-bulldog-orange prose-a:no-underline hover:prose-a:underline
           prose-img:rounded-xl prose-headings:font-semibold"
  >
    <h2>Fall 2026 Sports Schedules</h2>
      <img src="/assets/soccer26.jpg" />
      <p>
        *Note: the 09/18 and 10/16 games vs. Sumner have been cancelled.*
      </p>
      <img src="/assets/volleyball26v2.jpg" />
      <img src="/assets/xcountry26.jpg" />
      <img src="/assets/golf26.jpg" />
    <h2>Machias Memorial High School Athletic Programs</h2>
  </article>
</Base>
