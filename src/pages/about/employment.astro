---
import Base from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/PageHero.astro";
import { site } from "~/site.config";

const title = "Employment";
const subtitle = "";
const description = "";

// Breadcrumbs: last item is current page (no href)
const breadcrumb = [
  { label: "Home", href: "/" },
  { label: "About" },
  { label: title },
];
---
<Base title={`${title} | ${site.name}`} description={description}>
  <PageHero title={title} subtitle={subtitle} breadcrumb={breadcrumb} />

  <!-- Long-form content gets Typography styles -->
  <article
    class="prose prose-slate md:prose-lg mx-auto max-w-3xl px-4 py-10
           prose-a:text-bulldog-orange prose-a:no-underline hover:prose-a:underline
           prose-img:rounded-xl prose-headings:font-semibold"
  >
    <h2>Current Employment Opportunities</h2>
    <p>
Long Term Substitute Teacher
    </p>
    <p>
Special Education Educational Technicians
    </p>
     <p>
Part Time Custodian ~ Rose M. Gaffney Elementary
    </p>
     <p>
Substitute Custodian
     </p>
     <p>
Long Term Educational Technician Substitute
     </p>
     <p>
Special Education Educational Technician
     </p>
    <p>
Substitute School Nurse/Substitute Custodians
    </p>
    <p>
   	 <a class="link"
		href="https://www.servingschools.com/employerjobs/7n97/aos-96-machias-bay"
   	 >AOS 96 Machias Bay Jobs</a>
    </p>
  </article>
</Base>
