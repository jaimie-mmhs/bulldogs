---
import Base from "~/layouts/BaseLayout.astro";
import PageHero from "~/components/PageHero.astro";
import {site} from "~/site.config";

const title = "Meals";
const subtitle = "Breakfast and lunch are free to all students.";
const description = "";

// Breadcrumbs: last item is current page (no href)
const breadcrumb = [{label: "Home", href: "/"}, {label: title}];
---

<Base title={`${title} | ${site.name}`} description={description}>
  <PageHero title={title} subtitle={subtitle} breadcrumb={breadcrumb} />

  <div class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-8 lg:grid-cols-[1.65fr_1fr] items-start">
      <article
        class="prose prose-slate md:prose-lg
               prose-a:text-bulldog-orange prose-a:no-underline hover:prose-a:underline
               prose-img:rounded-xl prose-headings:font-semibold"
      >
        <h2>Lunch Menu</h2>
        <h3>September 2026</h3>
        <img src="/assets/sept26menu_page-0001.jpg" class="rounded-xl shadow" />

        <p>
          <a class="link" href="/assets/marchmenu.pdf">Download the PDF menu</a>
        </p>
      </article>

      <aside class="lg:sticky lg:top-6">
        <article
          class="rounded-2xl border bg-white p-4 shadow-sm hover:shadow-md max-w-[200px] ml-auto"
        >
          <h3 class="text-lg font-semibold">Application</h3>
          <p class="mt-2 text-sm text-slate-600">
            <a
              class="link"
              href="https://www.nlappscloud.com/Welcome.aspx?cf=District&apply=1&api=2bd043fa3cfff8cfe8d4ae5a74646d06"
            >
              Free &amp; Reduced Lunch Application</a
            >
          </p>
        </article>
      </aside>
    </div>
  </div>
</Base>
